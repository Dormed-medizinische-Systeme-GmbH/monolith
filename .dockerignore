# Build-Kontext ist das Repo-Wurzelverzeichnis — alles fernhalten, was die
# Images nicht brauchen. Ohne das wandern u. a. 58 MB Prospekt-PDFs und
# mehrere vendor/-Baeume in jeden Build-Kontext.
.git
.github
.docs
.ai
.claude
.legacy

**/vendor
**/node_modules
**/.env
**/storage/logs/*
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/public/build
**/public/hot
**/public/storage
**/bootstrap/cache/*
**/.phpunit.cache
**/.phpunit.result.cache
**/tests

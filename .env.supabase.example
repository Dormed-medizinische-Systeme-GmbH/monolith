# Environment variables for docker-compose.yml (self-hosted Supabase stack).
#
# This is SEPARATE from the Laravel app's .env / .env.example. Do not rename
# this to plain ".env" — Docker Compose auto-loads a file literally named
# ".env" in this directory, which would collide with Laravel's own .env.
# To use this file with plain `docker compose`, pass it explicitly:
#   docker compose --env-file .env.supabase up
#
# On Coolify this file is documentation only. Coolify recognizes the
# SERVICE_<TYPE>_<NAME> syntax used throughout docker-compose.yml
# (SERVICE_FQDN_*, SERVICE_URL_*, SERVICE_USER_*, SERVICE_PASSWORD_*,
# SERVICE_PASSWORD_64_*, SERVICE_BASE64_*) and auto-generates real values
# for those at deploy time — they show up (editable, except FQDN/URL) in the
# Coolify UI. Do NOT paste real secrets for those into this example file.

# ---------------------------------------------------------------------------
# Auto-generated by Coolify — do not set manually, listed for documentation
# ---------------------------------------------------------------------------
SERVICE_FQDN_SUPABASEKONG=
SERVICE_URL_SUPABASEKONG=
SERVICE_FQDN_SUPABASEKONG_8000=
SERVICE_URL_SUPABASEKONG_8000=
SERVICE_USER_ADMIN=
SERVICE_PASSWORD_ADMIN=
SERVICE_PASSWORD_JWT=
SERVICE_PASSWORD_POSTGRES=
SERVICE_PASSWORD_PGMETACRYPTO=
SERVICE_PASSWORD_LOGFLARE=
SERVICE_PASSWORD_LOGFLAREPRIVATE=
SERVICE_USER_MINIO=
SERVICE_PASSWORD_MINIO=
SERVICE_PASSWORD_SUPAVISORSECRET=
SERVICE_PASSWORD_VAULTENC=

# These three are Supabase-specific signed-JWT/asymmetric-key values (not a
# plain random password/user/FQDN), so they don't necessarily fall under the
# generic magic-var types documented by Coolify (FQDN/URL/USER/PASSWORD/
# PASSWORD_64/BASE64...). This compose file matches Coolify's bundled
# one-click "Supabase" service template, which is expected to generate these
# too — VERIFY in the Coolify UI after first deploy. If any of them show up
# empty there, they must be derived manually as JWTs signed with
# SERVICE_PASSWORD_JWT (anon / service_role claims) per the Supabase
# self-hosting docs before the stack will work.
SERVICE_SUPABASEANON_KEY=
SERVICE_SUPABASESERVICE_KEY=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ---------------------------------------------------------------------------
# ACHTUNG — vermutlicher Bug/Typo im Compose-Template (Zeile ~315):
#   realtime-dev: SECRET_KEY_BASE=${SECRET_PASSWORD_REALTIME}
# Der Name folgt NICHT dem Coolify-Muster SERVICE_<TYPE>_<NAME> (er beginnt
# mit SECRET_ statt SERVICE_), wird also NICHT automatisch generiert — und
# hat im Compose-File keinen Fallback-Default. Ohne manuell gesetzten Wert
# startet der realtime-Service mit leerem SECRET_KEY_BASE (Phoenix/Elixir
# braucht dafür einen langen zufälligen String) und crasht vermutlich beim
# Boot. Bis das im Compose-File korrigiert ist (vermutlich sollte es
# SERVICE_PASSWORD_REALTIME heißen), hier manuell einen starken Zufallswert
# setzen, z. B.: openssl rand -base64 48
# ---------------------------------------------------------------------------
SECRET_PASSWORD_REALTIME=

# ---------------------------------------------------------------------------
# Optional — nur bei Bedarf setzen (leer lassen ist ein gültiger Zustand)
# ---------------------------------------------------------------------------
# Zusätzliche erlaubte Redirect-URLs für Supabase Auth (Komma-getrennt)
ADDITIONAL_REDIRECT_URLS=
# Aktiviert asymmetrische (ES256) JWTs zusätzlich zum symmetrischen HS256-Secret
ANON_KEY_ASYMMETRIC=
# Für Supabase-Studio-Funktionen, die einen OpenAI-Key nutzen (z. B. SQL-Assistent)
OPENAI_API_KEY=

# SMTP für Supabase Auth (Passwort-Reset, Magic Link, Bestätigungsmails).
# Leer lassen deaktiviert den echten Mailversand nicht automatisch — GoTrue
# versucht dann trotzdem zu senden und schlägt fehl. Für lokale/Test-Umgebungen
# ENABLE_EMAIL_AUTOCONFIRM=true setzen, um E-Mail-Bestätigung zu umgehen.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=

# Mailer-Templates/Betreffzeilen (leer = Supabase-Standardtemplates)
MAILER_TEMPLATES_INVITE=
MAILER_TEMPLATES_CONFIRMATION=
MAILER_TEMPLATES_RECOVERY=
MAILER_TEMPLATES_MAGIC_LINK=
MAILER_TEMPLATES_EMAIL_CHANGE=
MAILER_SUBJECTS_CONFIRMATION=
MAILER_SUBJECTS_RECOVERY=
MAILER_SUBJECTS_MAGIC_LINK=
MAILER_SUBJECTS_EMAIL_CHANGE=
MAILER_SUBJECTS_INVITE=

# ---------------------------------------------------------------------------
# Anwendungs-Konfiguration — hat Defaults im Compose-File (":-..."), hier nur
# eintragen, wenn vom Default abgewichen werden soll
# ---------------------------------------------------------------------------
# POSTGRES_HOST=supabase-db
# POSTGRES_HOSTNAME=supabase-db
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres

# PGRST_DB_SCHEMAS=public,storage,graphql_public
# PGRST_DB_MAX_ROWS=1000
# PGRST_DB_EXTRA_SEARCH_PATH=public

# STUDIO_DEFAULT_ORGANIZATION=Default Organization
# STUDIO_DEFAULT_PROJECT=Default Project

# API_EXTERNAL_URL=http://supabase-kong:8000
# JWT_EXPIRY=3600

# DISABLE_SIGNUP=false
# ENABLE_EMAIL_SIGNUP=true
# ENABLE_ANONYMOUS_USERS=false
# ENABLE_EMAIL_AUTOCONFIRM=false
# ENABLE_PHONE_SIGNUP=true
# ENABLE_PHONE_AUTOCONFIRM=true

# FUNCTIONS_VERIFY_JWT=false
# STORAGE_TENANT_ID=storage-single-tenant
# IMGPROXY_AUTO_WEBP=true

# KONG_STORAGE_CONNECT_TIMEOUT=60
# KONG_STORAGE_WRITE_TIMEOUT=3600
# KONG_STORAGE_READ_TIMEOUT=3600
# KONG_STORAGE_REQUEST_BUFFERING=false
# KONG_STORAGE_RESPONSE_BUFFERING=false

# POOLER_TENANT_ID=dev_tenant
# POOLER_DEFAULT_POOL_SIZE=20
# POOLER_MAX_CLIENT_CONN=100
# POOLER_DB_POOL_SIZE=5

# ==========================================================================
# Vorlage fuer die lokale Entwicklung. `cp .env.example .env` und der
# Dev-Stack laeuft ohne weitere Eingriffe:
#
#     docker compose -f docker-compose.dev.yaml up -d --build
#
# Alle Werte hier sind Dev-Standardwerte und bewusst oeffentlich. Postgres und
# MinIO im Dev-Stack sind FLUECHTIG (tmpfs) — sie vergessen alles beim Stoppen
# und werden bei jedem Start frisch migriert und geseedet (ADR-041).
# Deshalb ist an diesen Zugangsdaten nichts zu schuetzen.
#
# Produktion fuellt dieselben Schluessel mit echten Werten aus den externen
# Coolify-Ressourcen (Postgres, S3) — siehe .docs/06-infrastructure/HOSTING.md.
# ==========================================================================

APP_NAME=Dormed
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://dormed.test

# --- Die vier Zugriffspunkte (ADR-033/038) -------------------------------
# Nie als Literal in eine Route-Datei, immer ueber die Konfiguration.
# Lokal per /etc/hosts auf 127.0.0.1 zeigen lassen:
#   127.0.0.1 dormed.test erp.dormed.test my.dormed.test shop.dormed.test
#
# OHNE PORT, auch wenn der Dev-Stack auf :8000 laeuft. Laravels HostValidator
# matcht gegen Request::getHost(), und das schneidet den Port ab — mit Port
# hier trifft keine einzige Route (404 auf allen vier Hosts).
APP_DOMAIN_WEBSITE=dormed.test
APP_DOMAIN_ERP=erp.dormed.test
APP_DOMAIN_PORTAL=my.dormed.test
APP_DOMAIN_SHOP=shop.dormed.test

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL (ADR-001) ------------------------------------------------
# Dev: Service `pgsql` aus docker-compose.dev.yaml, tmpfs, fluechtig.
# Prod: externe Coolify-Datenbank-Ressource, eigener Lebenszyklus (ADR-033).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=dormed
DB_USERNAME=dormed
DB_PASSWORD=secret

# --- Datenbankrollen (ADR-036) -------------------------------------------
# DB_USERNAME oben ist der Schema-EIGENTUEMER. Er legt an und migriert —
# die Anwendung verbindet sich nie so, weil Postgres RLS auf den Eigentuemer
# still nicht anwendet. Zur Laufzeit gilt eine der drei Rollen hier, je
# Zugriffspunkt (siehe config/database.php).
#
# Angelegt werden sie von der Migration `create_database_roles`, die diese
# Werte liest. Wer sie aendert, muss die Rollen neu anlegen — im Dev-Stack
# passiert das bei jedem `up` von selbst, weil alles fluechtig ist.
DB_USERNAME_STAFF=dormed_staff
DB_PASSWORD_STAFF=secret
DB_USERNAME_CUSTOMER=dormed_customer
DB_PASSWORD_CUSTOMER=secret
DB_USERNAME_PUBLIC=dormed_public
DB_PASSWORD_PUBLIC=secret

# Infrastruktur-Tabellen haengen an einer FESTEN Verbindung, nicht an der
# Standardverbindung. Sonst folgen Session, Cache und Queue der Umschaltung aus
# ADR-036 mit — ein Request auf dormed.de wuerde seine Session dann ueber
# `dormed_public` lesen wollen, das darauf keine Grants hat. Sessions, Cache und
# Jobs sind Infrastruktur, keine Fachdaten; sie kennen keinen Zugriffspunkt.
SESSION_CONNECTION=pgsql
DB_CACHE_CONNECTION=pgsql
DB_CACHE_LOCK_CONNECTION=pgsql
DB_QUEUE_CONNECTION=pgsql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Fuehrender Punkt: haelt die Kundensession ueber my. und shop. hinweg (ADR-037)
SESSION_DOMAIN=.dormed.test

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Object Storage: MinIO im Dev, S3 in Prod (ADR-025/028) --------------
# WICHTIG, kostet sonst eine Stunde Suche:
#   AWS_ENDPOINT ist die Adresse aus Sicht des PHP-Containers (Docker-Netz).
#   AWS_URL ist die Adresse aus Sicht des BROWSERS (veroeffentlichte Links).
#   Beide zeigen auf dasselbe MinIO, aber ueber verschiedene Wege.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=dormed
AWS_SECRET_ACCESS_KEY=secret12345
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dormed-public
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/dormed-public
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dormed.de"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Dev-Stack-Ports (nur docker-compose.yaml) ---------------------------
# Port 80, damit die Hostnamen ohne Portangabe im Browser funktionieren.
# Ein Port fuer alle vier — zugeordnet wird am Host-Header, nie am Port.
#   http://dormed.test        http://shop.dormed.test
#   http://erp.dormed.test    http://my.dormed.test
APP_PORT=80
VITE_PORT=5173
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WWWUSER=1000
WWWGROUP=1000
